{
    "name": "fanxielab/fanxie-wp-core",
    "description": "Modular WordPress security, hardening, maintenance, and performance toolkit by Fanxie Lab.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://fanxielab.com/plugins/fanxie-wp-core",
    "authors": [
        {
            "name": "Fanxie Lab",
            "homepage": "https://fanxielab.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "FanxieLab\\WPCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FanxieLab\\WPCore\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:coverage": "phpunit --coverage-html=coverage/html --coverage-clover=coverage/clover.xml",
        "check": [
            "@phpcs",
            "@phpstan"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Run WordPress Coding Standards checks (phpcs.xml.dist).",
        "phpcbf": "Auto-fix fixable WordPress Coding Standards violations.",
        "phpstan": "Run PHPStan static analysis (level 8, phpstan.neon.dist).",
        "test": "Run the full PHPUnit test suite (unit + integration).",
        "test:unit": "Run the fast Brain Monkey unit suite only (no WordPress runtime).",
        "test:integration": "Run the WordPress integration suite (requires wp-env tests-cli).",
        "test:coverage": "Run PHPUnit with HTML (coverage/html) + Clover (coverage/clover.xml) coverage reports.",
        "check": "Run the quality gate: PHPCS + PHPStan. Tests run via `composer test`."
    }
}
