{
	"name": "fanxie-warden",
	"version": "0.0.0",
	"private": true,
	"description": "Fanxie Warden — WordPress plugin. Repo-root tooling (wp-env, dev scripts). The Vue admin SPA lives under assets/admin/ with its own package.json.",
	"license": "GPL-2.0-or-later",
	"author": "Fanxie Lab",
	"engines": {
		"node": ">=20",
		"npm": ">=10"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:restart": "wp-env stop && wp-env start",
		"env:destroy": "wp-env destroy",
		"env:clean": "wp-env clean all",
		"env:clean:dev": "wp-env clean development",
		"env:clean:tests": "wp-env clean tests",
		"env:logs": "wp-env logs",
		"env:logs:tests": "wp-env logs tests",
		"env:cli": "wp-env run cli wp",
		"env:cli:tests": "wp-env run tests-cli wp",
		"env:install-path": "wp-env install-path",
		"test:php": "npm run test:php:unit && npm run test:php:integration",
		"test:php:unit": "./vendor/bin/phpunit --testsuite=unit",
		"test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/fanxie-wp-core ./vendor/bin/phpunit --testsuite=integration",
		"test:php:watch": "wp-env run tests-cli --env-cwd=wp-content/plugins/fanxie-wp-core ./vendor/bin/phpunit --watch",
		"test:php:coverage": "wp-env run tests-cli --env-cwd=wp-content/plugins/fanxie-wp-core ./vendor/bin/phpunit --coverage-text",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"lint:php": "composer run lint",
		"plugin:check": "wp-env run cli wp plugin check fanxie-wp-core --format=table",
		"plugin:check:json": "wp-env run cli wp plugin check fanxie-wp-core --format=json",
		"db:cli": "wp-env run cli wp db cli",
		"db:reset": "wp-env run cli wp db reset --yes",
		"check:php": "composer run check",
		"check:js": "cd assets/admin && npm run check",
		"check": "npm run check:php && npm run check:js"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@wordpress/env": "^10.0.0"
	}
}
