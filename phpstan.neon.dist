# PHPStan 2.x configuration. Extension, config keys, and defaults all assume
# phpstan/phpstan ^2.0 and szepeviktor/phpstan-wordpress ^2.0. When bumping
# PHPStan, re-read the upgrade guide — some defaults (e.g.
# `treatPhpDocTypesAsCertain`) have flipped between majors.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8

    # Target PHP runtime — matches composer.json `require.php` (>=8.1).
    phpVersion: 80100

    # Load runtime constants that `fanxie-wp-core.php` defines lazily at request
    # time so PHPStan can resolve them during static analysis. File is also
    # reused by the Phase 0.3 PHPUnit harness.
    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # Paths analysed. Composer bootstrap file + uninstall handler + everything
    # under `src/`. Tests are deliberately NOT in scope: unit tests depend on
    # Brain Monkey's dynamic function redefinition, integration tests depend on
    # WP_UnitTestCase + WP test-suite symbols that are not shipped as stubs,
    # and PHPUnit fixtures routinely violate level-8 strictness (mutable state,
    # untyped factory returns). Tests are their own quality gate (they either
    # pass or fail) — static analysis adds friction without catching real bugs.
    paths:
        - src
        - fanxie-wp-core.php
        - uninstall.php

    # Paths PHPStan should ignore even if one of the paths above would otherwise
    # recurse into them.
    # `(?)` marks an optional path — PHPStan 2.x hard-errors on missing
    # excludePaths entries; `build/` and `dist/` only exist after a release
    # bundle has been generated locally.
    excludePaths:
        - vendor
        - node_modules
        - assets
        - build (?)
        - dist (?)
        - languages
        - tests
        - .phpunit.cache

    # Disallow weak typing shortcuts we explicitly do not want in this codebase.
    treatPhpDocTypesAsCertain: false

    # Do not fail on the rare places where the WP ecosystem legitimately needs
    # `@phpstan-ignore-*` annotations. Keep the list tight — no broad excludes.
    reportUnmatchedIgnoredErrors: true
