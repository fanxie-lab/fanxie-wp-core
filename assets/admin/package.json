{
  "name": "@fanxie-wp-core/admin",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Fanxie WP Core — Vue 3 admin SPA. Built with Vite; output consumed by the PHP plugin (wp_enqueue_script/style against dist/admin.js + dist/admin.css).",
  "license": "GPL-2.0-or-later",
  "author": "Fanxie Lab",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,vue}' '*.config.ts'",
    "lint:fix": "eslint 'src/**/*.{ts,vue}' '*.config.ts' --fix",
    "format": "prettier --write 'src/**/*.{ts,vue,css}' '*.config.ts' '*.config.js'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css}' '*.config.ts' '*.config.js'",
    "check": "npm run format:check && npm run lint && npm run type-check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/lexend": "^5.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.6"
  }
}
