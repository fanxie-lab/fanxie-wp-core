# Editor defaults for the Fanxie WP Core admin SPA.
# Mirrors prettier.config.js so unsaved-file formatting matches committed style.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
